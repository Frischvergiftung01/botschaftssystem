# Kopie als .env anlegen. In Coolify stattdessen unter "Environment Variables" eintragen.
PORT=3000
DB_PFAD=./data/botschaften.db

# Eingabe
MAX_ZEICHEN=120
MAX_ZEICHEN_NAME=15
EMPFOHLENE_ZEICHEN=35
NAME_ERLAUBT=true
SPERRE_SEKUNDEN=30

# Anzeige
STANDZEIT=25
MAX_VERSALHOEHE=40
MIN_VERSALHOEHE=22

# Filterkette (Block 4). Auf false stellen, sobald Moderation und Filter stehen.
AUTO_FREIGABE=true

# Ab Block 4: Schluessel NIEMALS hier eintragen, sondern in Coolify hinterlegen.
# MISTRAL_API_KEY=
