# Kopie als .env anlegen. In Coolify stattdessen unter "Environment Variables" eintragen.
PORT=3000
DB_PFAD=./data/botschaften.db

# Eingabe
MAX_ZEICHEN=120
MAX_ZEICHEN_NAME=15
EMPFOHLENE_ZEICHEN=35
NAME_ERLAUBT=true
SPERRE_SEKUNDEN=120

# Anzeige
STANDZEIT=25
MAX_VERSALHOEHE=40
MIN_VERSALHOEHE=22

# Filterkette (Block 4). Nur noch der STARTWERT - im Betrieb wird der Schalter
# in der Moderation umgelegt und steht dann in der Datenbank.
AUTO_FREIGABE=true

# Moderation (Block 5). Ohne Kennwort bleibt /moderation zu.
# Mindestens 8 Zeichen. In Coolify eintragen, nicht hier.
# MODERATION_KENNWORT=
MODERATION_SITZUNG_STUNDEN=14
RASTER_GROESSE=12
# Werkzeug "Datenbank leeren" - am 5. November auf false stellen.
DATENBANK_LEEREN=true

# Ab Block 4: Schluessel NIEMALS hier eintragen, sondern in Coolify hinterlegen.
# MISTRAL_API_KEY=
